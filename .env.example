# ============================================================================
#  TrendHunter Pro · Variables de entorno
# ----------------------------------------------------------------------------
#  Copia este archivo a `.env` y rellena lo que necesites:
#
#      cp .env.example .env
#
#  La aplicación funciona al 100 % con la configuración mínima (base de datos
#  SQLite + secreto de sesión). El resto de bloques son opcionales y activan
#  integraciones reales (Google, Stripe, IA, Redis, SMTP, scrapers).
# ============================================================================

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
#  0 · Modo de costes (obligatorio decidirlo; por defecto 'gratis')
# ---------------------------------------------------------------------------
#   'gratis'      solo fuentes sin coste (Shopify, Meta, YouTube, RSS, CSV).
#   'produccion'  ademas permite los proveedores de pago (SerpAPI, Apify).
# Cambiarlo no requiere codigo: variable + reiniciar el proceso.
MODO_COSTES="gratis"

#  1 · Base de datos (obligatorio)
# ---------------------------------------------------------------------------
# SQLite (por defecto, cero configuración para desarrollo):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/trendhunter.db"
# DIRECT_URL solo hace falta en PostgreSQL (Supabase);
# en SQLite puede omitirse (Prisma usa DATABASE_URL).

# PostgreSQL (producción, Railway/Neon/Supabase):
# DATABASE_PROVIDER="postgresql"
# En Supabase se usan DOS cadenas:
#  · DATABASE_URL  -> pooler (puerto 6543, "Transaction mode"): la app.
#  · DIRECT_URL    -> conexion directa (puerto 5432): migraciones
#                    y respaldos (pg_dump). Obligatoria en Supabase.
#
# Ejemplo con Supabase:
# DATABASE_URL="postgresql://usuario:password@db.supabase.com:6543/postgres?schema=public&pgbouncer=true"
# DIRECT_URL="postgresql://usuario:password@db.supabase.com:5432/postgres?schema=public"
# DATABASE_URL="postgresql://usuario:password@host:5432/trendhunter?schema=public"
#
# Al cambiar de proveedor, regenera el cliente (Prisma fija el motor al
# generarlo: un cliente de SQLite NO sirve con el adaptador de PostgreSQL):
#   npm run db:provider postgres
#   npm run db:generate
#   npm run db:bootstrap     # crea el esquema (DDL idempotente)
#   npm run db:seed          # datos reales de demostración
#
# El contenedor lo hace solo al arrancar (scripts/arranque.mjs). Para revisar
# el SQL a mano: prisma/postgres-inicial.sql (npm run db:migration:postgres).
#
# AUTO_SEED="true"     # cargar datos de demo si la base está vacía (Docker)
# AUTO_SEED="false"    # nunca cargar datos de demostración

# ---------------------------------------------------------------------------
#  2 · Sesiones y URL pública (obligatorio en producción)
# ---------------------------------------------------------------------------
# Genera un secreto nuevo con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-bytes"
NEXTAUTH_SECRET=""

# URL pública de la aplicación (usada en correos, redirecciones de Stripe y OG).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL base alternativa que usan los scripts de datos: BASE_URL
BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
#  9b · Proveedores de datos reales (senales de tendencia)
# ---------------------------------------------------------------------------
# TrendHunter funciona con datos internos; si rellenas estas claves, la
# captura diaria lee senales REALES y sustituye las estimaciones. Cada
# proveedor es independiente: lo que no este configurado se omite.
#
# Shopify (gratis, sin claves): cualquier tienda Shopify expone su
#   catalogo en /products.json y /collections.json.
#
# Google Trends via SerpAPI -> https://serpapi.com/manage-api-key (desde 75 $/mes)
SERPAPI_KEY=""
# Pais objetivo de las busquedas (codigo ISO de dos letras):
GEO_OBJETIVO="ES"
#
# TikTok via Apify -> https://console.apify.com/account/integrations (desde 39 $/mes)
APIFY_TOKEN=""
#
# YouTube Data API v3 -> https://console.cloud.google.com/apis/credentials
# Gratis: 10.000 unidades/dia ~ 100 busquedas diarias para siempre.
YOUTUBE_API_KEY=""
#
# Meta Ad Library (anuncios publicos). Requiere app de Meta verificada:
#   https://developers.facebook.com
FACEBOOK_ACCESS_TOKEN=""
META_AD_LIBRARY_VERSION="v21.0"
#
# TikTok Creative Center (VIA GRIS, opt-in): panel publico sin login;
# puede romperse sin aviso; solo se intenta si Apify no esta configurado.
TIKTOK_CREATIVE_CENTER="false"
#
# DATOS_REALES=true: un proveedor sin configurar devuelve 503 en lugar
# de calculos internos. Garantiza que solo se sirve dato real.
DATOS_REALES="false"

# Correo del administrador creado por el seed.
ADMIN_EMAIL="admin@trendhunter.pro"

# ---------------------------------------------------------------------------
#  3 · Autenticación con Google (opcional)
# ---------------------------------------------------------------------------
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
#  4 · Inteligencia artificial (opcional)
# ---------------------------------------------------------------------------
# Proveedor preferido: "openai" | "gemini". Si no se indica, se elige el que
# tenga claves disponibles. Sin claves se usa el motor de plantillas local
# (100 % funcional, sin coste).
AI_PROVIDER=""

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
# GOOGLE_API_KEY=""          # alternativa a GEMINI_API_KEY
GEMINI_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
#  5 · Stripe (opcional, modo demostración sin claves)
# ---------------------------------------------------------------------------
# Panel de Stripe → Desarrolladores → Claves de API
STRIPE_SECRET_KEY=""
# Precios recurrentes creados en el panel de Stripe (price_…):
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_AGENCY=""
# Secreto del webhook (Stripe → Desarrolladores → Webhooks → endpoint):
#   URL del endpoint: ${NEXT_PUBLIC_APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
#  6 · Redis + BullMQ (opcional, para trabajos en segundo plano)
# ---------------------------------------------------------------------------
# Sin REDIS_URL los trabajos pesados se ejecutan inline en la propia app.
# Con REDIS_URL arranca los workers con:  npm run worker
REDIS_URL=""

# ---------------------------------------------------------------------------
#  7 · Correo transaccional SMTP (opcional)
# ---------------------------------------------------------------------------
# Sin SMTP los correos se registran en consola (el flujo nunca se rompe).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TrendHunter Pro <no-reply@trendhunter.pro>"

# ---------------------------------------------------------------------------
#  8 · Scraping real con Playwright (opcional)
# ---------------------------------------------------------------------------
# Instala el navegador:  npx playwright install chromium
# Después indica la ruta del ejecutable para activar el motor real.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=""
# PLAYWRIGHT_BROWSERS_PATH=""
# CHROMIUM_PATH=""
# Fuerza el motor real aunque no se detecte el binario automáticamente:
SCRAPING_REAL="false"
# Desactiva por completo el navegador y usa siempre el motor determinista:
SCRAPER_FORCE_SIMULATED="false"
# Evita descargar HTML adicional en el análisis de fichas de producto:
SCRAPER_DISABLE_HTML="false"

# ---------------------------------------------------------------------------
#  10 · Alertas por Telegram (opcional, gratis)
# ---------------------------------------------------------------------------
# Bot: @BotFather · Chat id: @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Webhook generico (Slack, Discord, n8n, Make...):
ALERT_WEBHOOK_URL=""

# Secreto para lanzar tareas programadas desde fuera (GitHub Actions):
CRON_SECRET=""

# ---------------------------------------------------------------------------
#  11 · PWA y notificaciones push (opcional, gratis)
# ---------------------------------------------------------------------------
# Genera el par de claves UNA vez y guárdalo:
#   npx web-push generate-vapid-keys
# Sin estas tres variables la app funciona igual: las alertas quedan en la
# campana y se entregan por correo, Telegram y webhook.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto del remitente: los servicios push lo exigen (mailto: o https:).
VAPID_SUBJECT="mailto:admin@trendhunter.pro"
