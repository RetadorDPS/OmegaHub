# ============================================================================
#  TrendHunter Pro · Variables de entorno
# ----------------------------------------------------------------------------
#  Copia este archivo a `.env` y rellena lo que necesites:
#
#      cp .env.example .env
#
#  La aplicación funciona al 100 % con la configuración mínima (base de datos
#  SQLite + secreto de sesión). El resto de bloques son opcionales y activan
#  integraciones reales (Google, Stripe, IA, Redis, SMTP, scrapers).
# ============================================================================

# ---------------------------------------------------------------------------
#  1 · Base de datos (obligatorio)
# ---------------------------------------------------------------------------
# SQLite (por defecto, cero configuración para desarrollo):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/trendhunter.db"

# PostgreSQL (producción, Railway/Neon/Supabase):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://usuario:password@host:5432/trendhunter?schema=public"
#
# Al cambiar de proveedor, regenera el cliente y las migraciones:
#   npm run db:provider      # ajusta el provider del schema
#   npm run db:generate
#   npm run db:push          # crea las tablas
#   npm run db:seed          # carga los datos de demo

# ---------------------------------------------------------------------------
#  2 · Sesiones y URL pública (obligatorio en producción)
# ---------------------------------------------------------------------------
# Genera un secreto nuevo con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-bytes"
NEXTAUTH_SECRET=""

# URL pública de la aplicación (usada en correos, redirecciones de Stripe y OG).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL base alternativa que usan los scripts de datos: BASE_URL
BASE_URL="http://localhost:3000"

# Correo del administrador creado por el seed.
ADMIN_EMAIL="admin@trendhunter.pro"

# ---------------------------------------------------------------------------
#  3 · Autenticación con Google (opcional)
# ---------------------------------------------------------------------------
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
#  4 · Inteligencia artificial (opcional)
# ---------------------------------------------------------------------------
# Proveedor preferido: "openai" | "gemini". Si no se indica, se elige el que
# tenga claves disponibles. Sin claves se usa el motor de plantillas local
# (100 % funcional, sin coste).
AI_PROVIDER=""

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
# GOOGLE_API_KEY=""          # alternativa a GEMINI_API_KEY
GEMINI_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
#  5 · Stripe (opcional, modo demostración sin claves)
# ---------------------------------------------------------------------------
# Panel de Stripe → Desarrolladores → Claves de API
STRIPE_SECRET_KEY=""
# Precios recurrentes creados en el panel de Stripe (price_…):
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
# Secreto del webhook (Stripe → Desarrolladores → Webhooks → endpoint):
#   URL del endpoint: ${NEXT_PUBLIC_APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
#  6 · Redis + BullMQ (opcional, para trabajos en segundo plano)
# ---------------------------------------------------------------------------
# Sin REDIS_URL los trabajos pesados se ejecutan inline en la propia app.
# Con REDIS_URL arranca los workers con:  npm run worker
REDIS_URL=""

# ---------------------------------------------------------------------------
#  7 · Correo transaccional SMTP (opcional)
# ---------------------------------------------------------------------------
# Sin SMTP los correos se registran en consola (el flujo nunca se rompe).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TrendHunter Pro <no-reply@trendhunter.pro>"

# ---------------------------------------------------------------------------
#  8 · Scraping real con Playwright (opcional)
# ---------------------------------------------------------------------------
# Instala el navegador:  npx playwright install chromium
# Después indica la ruta del ejecutable para activar el motor real.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=""
# PLAYWRIGHT_BROWSERS_PATH=""
# CHROMIUM_PATH=""
# Fuerza el motor real aunque no se detecte el binario automáticamente:
SCRAPING_REAL="false"
# Desactiva por completo el navegador y usa siempre el motor determinista:
SCRAPER_FORCE_SIMULATED="false"
# Evita descargar HTML adicional en el análisis de fichas de producto:
SCRAPER_DISABLE_HTML="false"
