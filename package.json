{
  "name": "trendhunter-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrendHunter Pro - Plataforma SaaS de investigación de productos y tendencias para e-commerce y dropshipping",
  "scripts": {
    "arranque": "node scripts/arranque.mjs",
    "build": "node scripts/prisma-generate.mjs && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "captura:fuentes": "node scripts/captura-fuentes.mjs",
    "chromium": "node scripts/preparar-chromium.mjs",
    "confianza:recalcular": "tsx scripts/recalcular-confianza.ts",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migration:postgres": "node scripts/generate-postgres-migration.mjs",
    "db:provider": "node scripts/set-db-provider.mjs",
    "db:push": "prisma db push",
    "db:reset": "npm run db:bootstrap -- --force && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:bootstrap && npm run db:seed && npm run db:verify",
    "db:studio": "prisma studio",
    "db:verify": "node scripts/verify-db.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "lint": "oxlint src scripts prisma",
    "preview:pages": "node scripts/servir-pages.mjs",
    "respaldo": "node scripts/respaldo-supabase.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "setup": "npm run db:generate && npm run db:bootstrap && npm run db:seed",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:ui": "node scripts/audit-ui.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:api-v1": "node scripts/verificar-api-v1.mjs",
    "verify:confianza": "node scripts/verificar-confianza.mjs",
    "verify:equipos": "node scripts/verificar-equipos.mjs",
    "verify:ingesta": "tsx scripts/verificar-ingesta.mts",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:pwa": "node scripts/verificar-pwa.mjs",
    "worker": "tsx scripts/worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@google/genai": "2.30.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "bullmq": "6.3.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "14.3.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "openai": "7.34.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv-cli": "11.0.0",
    "jsdom": "30.1.3",
    "oxlint": "^1.88.0",
    "playwright-core": "1.64.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
