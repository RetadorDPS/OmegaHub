# ── Phone Agent · credenciales que debe conectar el usuario ────────────────
# 1) Android: copia estos valores a android-app/local.properties (ver README §4)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...tu-anon-key

# 2) Supabase Edge Functions (secretos del servidor, nunca en la app):
#    supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# 3) Alternativa MVP sin backend para la key: la app permite pegar la
#    Anthropic API Key en Ajustes (cifrada con EncryptedSharedPreferences).
ANTHROPIC_API_KEY=
