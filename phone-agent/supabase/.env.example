# ── Phone Agent · variables de las Edge Functions ──────────────────────────
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase en el servidor.
# Nunca copies una service_role key a Android ni la publiques en GitHub.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key-solo-servidor

# Para empezar sin Anthropic: crea una API key de Google AI Studio y guárdala
# SOLO como secreto de Edge Functions en Supabase.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Alternativa de pago, si en el futuro se prefiere Anthropic.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
