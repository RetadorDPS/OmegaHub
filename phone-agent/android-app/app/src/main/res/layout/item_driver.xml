<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvDriverName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="17sp" android:textStyle="bold" android:text="Claude" />
        <Switch android:id="@+id/switchAuthorized" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Autorizada" />
    </LinearLayout>
    <TextView android:id="@+id/tvDriverDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:text="com.anthropic.claude · instalada" />
    <CheckBox android:id="@+id/checkDual" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Es dual / clonada" />
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="8dp" android:background="#33FFFFFF" />
</LinearLayout>
