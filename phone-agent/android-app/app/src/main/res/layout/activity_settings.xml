<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F6F7FC" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="18dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ajustes y cuenta" android:textColor="#22243A"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Tu sesión y las preferencias de Phone Agent."
            android:textColor="#65697E" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
            android:text="CUENTA" android:textColor="#77798D" android:textSize="11sp"
            android:letterSpacing="0.12" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_result_card" android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tu cuenta de Phone Agent" android:textColor="#22243A"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textSize="13sp" android:textColor="#65697E"
                android:text="La conexión ya está preparada. No necesitas crear un proyecto ni copiar claves. Usa el mismo correo para conservar tu cuenta." />
            <TextView android:id="@+id/tvAuthState" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="#3F329F" android:textSize="14sp" android:textStyle="bold"
                android:text="Aún no has iniciado sesión" />
            <TextView android:id="@+id/tvAuthMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:textSize="13sp" android:visibility="gone" />
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="9dp"
                android:hint="Correo electrónico" android:inputType="textEmailAddress"
                android:importantForAutofill="no" />
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Contraseña"
                android:inputType="textPassword" android:importantForAutofill="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnSignIn" style="@style/Widget.PhoneAgent.PrimaryButton"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Iniciar sesión" />
                <Button android:id="@+id/btnSignUp" style="@style/Widget.PhoneAgent.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:text="Crear cuenta" />
            </LinearLayout>
            <Button android:id="@+id/btnSignOut" style="@style/Widget.PhoneAgent.DangerButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Cerrar sesión"
                android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#77798D"
                android:text="Al crear la cuenta, la sesión se inicia automáticamente y queda guardada en este teléfono." />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
            android:text="VOZ Y COMPORTAMIENTO" android:textColor="#77798D" android:textSize="11sp"
            android:letterSpacing="0.12" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_result_card" android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Palabra de activación" android:textColor="#22243A"
                android:textSize="16sp" android:textStyle="bold" />
            <EditText android:id="@+id/etWakeWord" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="oye agente" android:inputType="text" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Idioma de voz"
                android:textColor="#22243A" android:textSize="15sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spinnerLanguage" android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Autonomía"
                android:textColor="#22243A" android:textSize="15sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spinnerAutonomy" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textSize="12sp" android:textColor="#77798D"
                android:text="Leer = solo resume · Borrador = pide confirmar envíos · Actuar = ejecuta lo autorizado" />
            <CheckBox android:id="@+id/checkWakeWord" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Escucha automática en segundo plano (usa más batería)" />
            <Button android:id="@+id/btnSaveSettings" style="@style/Widget.PhoneAgent.PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Guardar preferencias" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
