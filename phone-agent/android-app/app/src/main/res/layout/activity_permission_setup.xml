<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F6F7FC" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="18dp" android:paddingBottom="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Permisos del teléfono" android:textColor="#22243A"
            android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#65697E" android:textSize="14sp"
            android:text="Te explicamos cada permiso y te llevamos al ajuste correspondiente. Android requiere que tú confirmes los permisos especiales." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
            android:text="NECESARIOS PARA HABLAR Y ACTUAR" android:textColor="#77798D"
            android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_result_card" android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🎙  Micrófono" android:textColor="#22243A" android:textSize="16sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvMicrophoneStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Comprobando…" android:textColor="#65697E" android:textSize="13sp" />
            <Button android:id="@+id/btnMicrophone" style="@style/Widget.PhoneAgent.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Permitir micrófono" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="16dp" android:background="#ECECF4" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="♿  Accesibilidad"
                android:textColor="#22243A" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvAccessibilityStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Comprobando…" android:textColor="#65697E" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textColor="#77798D" android:textSize="12sp"
                android:text="Busca Phone Agent y activa «Usar el servicio». Solo es para leer y tocar las apps que autorices." />
            <Button android:id="@+id/btnAccessibility" style="@style/Widget.PhoneAgent.PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Abrir Accesibilidad" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="16dp" android:background="#ECECF4" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="▣  Compartir pantalla"
                android:textColor="#22243A" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCaptureStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Comprobando…" android:textColor="#65697E" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textColor="#77798D" android:textSize="12sp"
                android:text="Android te preguntará al iniciar una tarea. La autorización puede volver a pedirse por sesión." />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:layout_marginBottom="8dp"
            android:text="OPCIONALES" android:textColor="#77798D" android:textSize="11sp"
            android:letterSpacing="0.12" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_result_card" android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Burbuja flotante" android:textColor="#22243A" android:textSize="15sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvOverlayStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Comprobando…" android:textColor="#65697E" android:textSize="13sp" />
            <Button android:id="@+id/btnOverlay" style="@style/Widget.PhoneAgent.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Permitir burbuja flotante" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="14dp" android:background="#ECECF4" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Avisos y alarmas"
                android:textColor="#22243A" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvNotificationsStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="Comprobando…" android:textColor="#65697E" android:textSize="13sp" />
            <Button android:id="@+id/btnNotifications" style="@style/Widget.PhoneAgent.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Permitir avisos de tareas" />
            <TextView android:id="@+id/tvExactAlarmStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Comprobando…" android:textColor="#65697E" android:textSize="13sp" />
            <Button android:id="@+id/btnExactAlarm" style="@style/Widget.PhoneAgent.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Permitir alarmas exactas" />
        </LinearLayout>

        <Button android:id="@+id/btnDone" style="@style/Widget.PhoneAgent.PrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Volver a Phone Agent" />
    </LinearLayout>
</ScrollView>
