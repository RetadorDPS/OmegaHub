<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/bg_result_card"
    android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tvMacroName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Nombre" android:textColor="#22243A" android:textSize="16sp"
            android:textStyle="bold" />
        <Switch android:id="@+id/switchMacroEnabled" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Activa" />
    </LinearLayout>
    <TextView android:id="@+id/tvMacroDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="6 pasos · se activa con: abre Claude" android:textColor="#65697E"
        android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/btnScheduleMacro" style="@style/Widget.PhoneAgent.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Programar" />
        <Button android:id="@+id/btnDeleteMacro" style="@style/Widget.PhoneAgent.DangerButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="Borrar" />
    </LinearLayout>
</LinearLayout>
